# Copy this file to .env and fill in the values. .env is gitignored.
# docker compose reads .env automatically at `up` time.
#
# Claude Code auth = a long-lived `claude setup-token` in CLAUDE_CODE_OAUTH_TOKEN
# (required, below). This is the SAME token OpenClaw uses — personal-vault
# `anthropic/oauth-token` (setup-token, Max-subscription quota, ~365d TTL).
# It is the SOLE auth gate when set and does NOT self-refresh, so rotate it
# before its ~2027-07-31 expiry: `claude setup-token` on the mini -> paste
# here -> `docker compose up -d receipt-assistant` -> update the vault +
# `openclaw models auth paste-token`. The host bind mount at
# ~/Developer/receipt-assistant-data/claude/ is now only an escape-hatch
# (unset this var + `claude /login`). See the `setup` skill + docker-compose.yml.

# ── Required ────────────────────────────────────────────────────────
# Long-lived Claude setup-token (see note above). Get it from personal-vault
# anthropic/oauth-token; NEVER commit the value — .env is gitignored.
CLAUDE_CODE_OAUTH_TOKEN=

# ── Optional ────────────────────────────────────────────────────────
# Everything below has sensible defaults; only override when needed.

# Parallel receipt extraction jobs. Each job spawns a claude subprocess,
# so increasing this raises memory + API load. Default: 3.
# MAX_CLAUDE_CONCURRENCY=3

# Claude model used for extraction. Default: sonnet.
# CLAUDE_MODEL=sonnet

# Google Maps API key. Used by the extraction agent (claude -p inside the
# container) to call Geocoding + Places APIs during Phase 3 of extraction.
# The agent skips geocoding silently when this is unset.
# GOOGLE_MAPS_API_KEY=

# HTTP server port. Default 3000. Also update the `ports:` mapping in
# docker-compose.yml if you change this.
# PORT=3000

# logo.dev API keys (#101 Phase 2 brand-icon acquisition). Obtain both
# from the logo.dev dashboard. The publishable key (pk_…) goes into
# img.logo.dev URLs; the secret key (sk_…) authorizes api.logo.dev/search.
# Phase 4b uses search-first against api.logo.dev to avoid the "any
# unknown domain returns a generated first-letter PNG" bug. The agent
# skips the logo.dev tier when either key is unset.
# LOGODEV_PUBLISHABLE_KEY=
# LOGODEV_SECRET_KEY=
